{#
  Base scene frame (docs/video-pipeline.md §5.3).

  Every replay frame inherits this chrome. The footer prints the recorded event
  sequence numbers the frame was built from — the never-fabricate rule made visible
  on screen rather than only asserted in tests — and the time-compression notice,
  so a squeezed step is labelled instead of hidden.

  Rendering must be deterministic: no animation, no transition, no network, no clock.
#}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ demo_title }} — {{ label or kind }}</title>
<style>
{#
  Bundled faces, inlined as data URIs by frames.font_face_css so the markup is
  self-contained and identical on any machine. Absent fonts are not an error:
  the rules are simply omitted and the stacks below fall through.
#}
{{ font_css | safe }}
  *, *::before, *::after {
    box-sizing: border-box;
    animation: none !important;
    transition: none !important;
  }
  :root {
    --bg: #0b1020;
    --panel: #121a2e;
    --panel-2: #0e1526;
    --edge: #26324d;
    --text: #e6edf7;
    --muted: #8ca0c4;
    --accent: #67e8f9;
    --warn: #fbbf24;
    --ok: #4ade80;
    --bad: #f87171;
    --mono: "DemoForge Mono", "Cascadia Code", Consolas, "DejaVu Sans Mono", monospace;
    --sans: "DemoForge Sans", "Segoe UI", system-ui, -apple-system, "Helvetica Neue",
            Arial, sans-serif;
  }
  html, body {
    margin: 0;
    padding: 0;
    width: {{ width }}px;
    height: {{ height }}px;
    overflow: hidden;
  }
  body {
    background:
      radial-gradient(1200px 700px at 18% -10%, #16203a 0%, transparent 60%),
      var(--bg);
    color: var(--text);
    font-family: var(--sans);
    display: grid;
    grid-template-rows: 88px 1fr auto 64px;
  }
  /* Show every recorded character as itself: a coding font's ligatures would draw
     `!=` as `≠` and `<-` as `←`, which is not what was typed. */
  * {
    font-variant-ligatures: none;
    font-feature-settings: "liga" 0, "clig" 0, "calt" 0, "dlig" 0;
  }
  /* Placed explicitly so the footer keeps its row whether or not a caption is shown. */
  .chrome { grid-row: 1; }
  .stage { grid-row: 2; }
  .caption { grid-row: 3; }
  .status { grid-row: 4; }

  /* ---- chrome ---- */
  .chrome {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 0 56px;
    border-bottom: 1px solid var(--edge);
    background: rgba(9, 13, 26, 0.6);
  }
  .chrome__brand {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent);
  }
  .chrome__demo {
    font-size: 24px;
    color: var(--text);
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .chrome__label {
    font-family: var(--mono);
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    border: 1px solid var(--edge);
    border-radius: 999px;
    padding: 7px 20px;
  }

  /* ---- stage ---- */
  .stage {
    padding: 44px 56px;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .panel {
    background: var(--panel);
    border: 1px solid var(--edge);
    border-radius: 18px;
    padding: 40px 48px;
    max-height: 100%;
    overflow: hidden;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 17px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 20px;
  }
  .prose {
    font-size: 34px;
    line-height: 1.45;
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .prose--lede { font-size: 40px; }
  .prose--dense { font-size: 26px; line-height: 1.4; }
  /* Claude's Markdown, rendered the way the reader saw it. */
  .md { white-space: normal; min-width: 0; }
  .md > * { margin: 0 0 0.55em; }
  .md > :last-child { margin-bottom: 0; }
  .md code { font-family: var(--mono); font-size: 0.86em; color: var(--accent); }
  .md strong { font-weight: 700; }
  .md-h { font-weight: 700; color: var(--accent); }
  .md-list { padding-left: 1.3em; }
  .md-list li { margin: 0 0 0.25em; }
  .md-code {
    font-family: var(--mono); font-size: 0.72em; line-height: 1.35;
    white-space: pre-wrap; overflow-wrap: anywhere;
    background: rgba(0, 0, 0, 0.28); border-radius: 10px; padding: 0.6em 0.8em;
  }
  .md-table { border-collapse: collapse; font-size: 0.78em; }
  .md-table th, .md-table td {
    text-align: left; padding: 0.22em 0.8em 0.22em 0; vertical-align: top;
    border-bottom: 1px solid rgba(148, 163, 184, 0.25);
  }
  .md-table th { color: var(--muted); font-weight: 600; }
  .say__body { flex: 1; min-width: 0; }
  .page {
    margin: 18px 0 0; font-family: var(--mono); font-size: 16px;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted);
  }
  .code { font-family: var(--mono); }
  .muted { color: var(--muted); }

  /* ---- explainer: what this kind of step is, for someone new to agents ---- */
  .explain {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin: 0 0 28px;
    padding: 18px 28px;
    border-left: 5px solid var(--accent);
    border-radius: 10px;
    background: rgba(103, 232, 249, 0.08);
    font-size: 29px;
    line-height: 1.4;
    color: var(--text);
  }
  .explain__tag {
    flex: none;
    font-family: var(--mono);
    font-size: 16px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* ---- caption: the narration's words, for viewers without sound ---- */
  .caption {
    margin: 0;
    padding: 22px 56px 24px;
    border-top: 1px solid var(--edge);
    background: #070b16;
    font-size: 30px;
    line-height: 1.42;
    color: #f4f7fc;
  }

  /* ---- status ---- */
  .status {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 0 56px;
    border-top: 1px solid var(--edge);
    font-family: var(--mono);
    font-size: 16px;
    color: var(--muted);
    background: rgba(9, 13, 26, 0.6);
  }
  .status__trace { flex: 1; }
  .status__compressed {
    color: var(--warn);
    border: 1px solid rgba(251, 191, 36, 0.45);
    border-radius: 999px;
    padding: 6px 18px;
  }
</style>
</head>
<body class="scene scene--{{ kind }}">
  <header class="chrome">
    <div class="chrome__brand">{{ set_title }}</div>
    <div class="chrome__demo">{{ demo_title }}</div>
    <div class="chrome__label">{{ label or kind }}</div>
  </header>

  <main class="stage">
{% if explain %}
    <p class="explain"><span class="explain__tag">What's happening</span><span>{{ explain }}</span></p>
{% endif %}
{% block stage %}{% endblock %}
  </main>

{% block caption %}
{% if caption %}
  <p class="caption">{{ caption }}</p>
{% endif %}
{% endblock %}

  <footer class="status">
    <span class="status__trace">
      captured events {{ event_seqs | join(", ") }} &middot; {{ demo_id }}
    </span>
{% if compressed %}
    <span class="status__compressed">
      &#9193; time-compressed &mdash; this step took {{ real_seconds | round(0) | int }}s in the real run
    </span>
{% endif %}
    <span class="status__progress">{{ index + 1 }} / {{ scene_count }}</span>
  </footer>
<script>
  // Safety net: the timeline paginates text and caps terminal lines to fit, but
  // the room on a card also depends on the caption under it. If a card still
  // overflows, shrink its text until it fits instead of clipping it.
  (function () {
    document.querySelectorAll(".fit").forEach(function (el) {
      var box = el.closest(".panel") || el;
      var size = parseFloat(getComputedStyle(el).fontSize);
      for (var i = 0; i < 40 && box.scrollHeight > box.clientHeight + 1 && size > 14; i++) {
        size -= 1;
        el.style.fontSize = size + "px";
      }
    });
  })();
</script>
</body>
</html>
