{# A message the person sent after reading Claude's answer, verbatim from events.jsonl. #}
{% extends "_base.html.j2" %}
{% block stage %}
  <style>
    .reply { display: flex; gap: 32px; align-items: flex-start; border-left: 6px solid var(--accent); }
    .reply__who {
      flex: none;
      font-family: var(--mono);
      font-size: 18px;
      letter-spacing: 0.1em;
      color: var(--accent);
      border: 1px solid rgba(103, 232, 249, 0.4);
      border-radius: 12px;
      padding: 12px 18px;
      margin-top: 6px;
    }
  </style>
  <div class="panel reply">
    <div class="reply__who">YOU</div>
    <div class="say__body">
      <div class="prose md fit {% if data.chars <= 320 %}prose--lede{% elif data.chars > 700 %}prose--dense{% endif %}">{{ data.html | safe }}</div>
      {%- if data.pages and data.pages > 1 %}<p class="page">part {{ data.page }} of {{ data.pages }}</p>{% endif %}
    </div>
  </div>
{% endblock %}
