{#
  One card of the demo's introduction: an intro narration block, as text.

  A card, not a scene: it explains the problem to the viewer and never says what the
  agent did, so it carries no captured-event claim. The words are the narration's
  own, so the screen and the voice can never disagree. A figure, when there is one,
  is drawn from a file in the demo folder and says which.
#}
{% extends "_card_base.html.j2" %}
{% block card %}
  <style>
    body { place-items: center start; text-align: left; }
    .card { padding: 0 150px; }
    .head {
      display: flex;
      align-items: baseline;
      gap: 28px;
      margin: 0 0 18px;
    }
    .num { font-family: var(--mono); font-size: 40px; color: var(--accent); }
    .title { font-size: 46px; font-weight: 600; margin: 0; letter-spacing: -0.01em; }
    .rule { margin: 30px 0 40px; }
    .para {
      font-size: 36px;
      line-height: 1.5;
      margin: 0 0 30px;
      max-width: 1500px;
    }
    .para:last-child { margin-bottom: 0; }
    .split { display: flex; gap: 70px; align-items: flex-start; }
    .split .words { flex: 1 1 0; }
    .split .para { font-size: 34px; }
    figure { margin: 0; flex: 0 0 auto; }
    figure .figure-plot { display: block; }
    .figure-plot .grid { stroke: var(--edge); stroke-width: 1; }
    .figure-plot .frame { fill: none; stroke: var(--muted); stroke-width: 1.5; }
    .figure-plot .trace { fill: none; stroke: var(--muted); stroke-width: 2; opacity: 0.6; }
    .figure-plot .point { fill: var(--accent); }
    .figure-plot .tick { fill: var(--muted); font-family: var(--mono); font-size: 22px; }
    .figure-plot .axis { fill: var(--text); font-family: var(--mono); font-size: 24px; }
    figcaption { margin-top: 18px; max-width: 760px; }
    figcaption .cap { font-size: 28px; margin: 0 0 8px; }
    figcaption .src { font-size: 22px; color: var(--muted); margin: 0; font-family: var(--mono); }
  </style>
  <p class="eyebrow">The problem{% if data.heading %} · {{ data.heading }}{% endif %}</p>
  <div class="head" style="margin-top: 22px">
    <span class="num">{{ "%02d" | format(data.number) }}</span>
    <p class="title">{{ data.title }}</p>
  </div>
  <div class="rule"></div>
{% if data.figure %}
  <div class="split">
    <div class="words">
{% for p in data.paragraphs %}
      <p class="para">{{ p }}</p>
{% endfor %}
    </div>
    <figure>
      {{ data.figure.svg | safe }}
      <figcaption>
        <p class="cap">{{ data.figure.caption }}</p>
        <p class="src">{{ data.figure.source }}</p>
      </figcaption>
    </figure>
  </div>
{% else %}
{% for p in data.paragraphs %}
  <p class="para">{{ p }}</p>
{% endfor %}
{% endif %}
{% endblock %}
