{# A recorded test result. Counts come from the capture, never from a rerun. #}
{% extends "_base.html.j2" %}
{% block stage %}
  <style>
    .badges { display: flex; gap: 28px; justify-content: center; }
    .badge {
      border: 1px solid var(--edge);
      border-radius: 18px;
      background: var(--panel);
      padding: 34px 54px;
      text-align: center;
      min-width: 260px;
    }
    .badge__n { font-family: var(--mono); font-size: 86px; line-height: 1; margin: 0; }
    .badge__k {
      font-family: var(--mono);
      font-size: 18px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--muted);
      margin: 16px 0 0;
    }
    .badge--pass .badge__n { color: var(--ok); }
    .badge--fail .badge__n { color: var(--bad); }
  </style>
  <div class="badges">
{% for key, value in data.items() | sort %}
    <div class="badge {% if 'pass' in key %}badge--pass{% elif 'fail' in key %}badge--fail{% endif %}">
      <p class="badge__n">{{ value | num }}</p>
      <p class="badge__k">{{ key | replace("_", " ") }}</p>
    </div>
{% endfor %}
  </div>
{% endblock %}
